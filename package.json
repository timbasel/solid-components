{
  "name": "@timbasel/solid-components",
  "version": "0.0.1",
  "private": false,
  "description": "A collection of reusable, efficient and styleable UI components using SolidJS",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "ui"
  ],
  "author": "Tim Basel <tim@basel-berlin.de>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/solid/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/index.js",
        "worker": "./dist/server/index.js",
        "deno": "./dist/server/index.js",
        "node": "./dist/server/index.js",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "cd docs && pnpm dev",
    "build": "tsdown",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsdown": "^0.22.3",
    "unplugin-solid": "^1.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
