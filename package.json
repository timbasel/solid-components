{
  "name": "@timbasel/solid-components",
  "version": "0.0.1",
  "private": false,
  "description": "A collection of reusable, efficient and styleable UI components using SolidJS",
  "keywords": [
    "components",
    "solid",
    "solidjs",
    "ui"
  ],
  "author": "Tim Basel <tim@basel-berlin.de>",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "solid": "./dist/solid/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./theme.css": {
      "development": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "dev": "cd docs && pnpm dev",
    "build": "tsdown",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsdown": "^0.22.3",
    "unplugin-solid": "^1.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13"
  }
}
